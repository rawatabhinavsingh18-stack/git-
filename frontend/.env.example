# ──────────────────────────────────────────────
# DeepDTA-Plus · Environment Variables
# ──────────────────────────────────────────────
#
# Copy this file to .env.local for local development.
# In Vercel, set these in Project Settings → Environment Variables.
#
# ──────────────────────────────────────────────

# URL of the FastAPI inference service. The prediction interface reports an
# error when this service is unavailable; it does not generate mock scores.
# Example: https://your-fastapi-app.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000
